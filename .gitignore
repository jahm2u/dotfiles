# Dotfiles .gitignore

# System files
.DS_Store
Thumbs.db
settings.local.json
*settings.local.json

.claude/telegram*
# Obsidian-specific exclusions
# Exclude personal workspaces
config/obsidian/workspace.json
config/obsidian/workspace-mobile.json

# Exclude plugin code/binaries (let Obsidian reinstall them)
config/obsidian/plugins/*/main.js
config/obsidian/plugins/*/manifest.json
config/obsidian/plugins/*/styles.css

# Exclude caches and transients
config/obsidian/cache/
config/obsidian/.trash/
config/obsidian/graph.json

# Exclude large backups (specific to plugins like make-md)
config/obsidian/backups/
config/obsidian/plugins/make-md/backups/
config/obsidian/plugins/*/backups/
*.mdb

# Exclude system/OS files in obsidian
config/obsidian/.DS_Store
config/obsidian/Thumbs.db

# Keep plugin settings but exclude plugin binaries
# This allows preserving plugin configurations while staying lightweight

# Environment files with sensitive data
.env
*.env
config/*/.env
settings.local.json

# Raycast - extensions may contain user-specific cache/data
config/raycast/extensions/*/cache/
config/raycast/extensions/*/data/

# Claude Code generated files - NEVER commit history or personal data
config/claude/todos/
config/claude/shell-snapshots/
config/claude/projects/
config/claude/statsig/
config/claude/debug/
config/claude/file-history/
config/claude/history.jsonl*
config/claude/*.backup
config/claude/.credentials.json
config/claude/.mcp.json
config/claude/cache/
config/claude/paste-cache/
config/claude/plans/
config/claude/plugins/
config/claude/stats-cache.json
config/claude/telemetry/
config/logs/
config/sketchybar/logs/

# BMAD generated documentation
BMAD*
*.context.xml
test_env_config.py

# Claude Code history and settings (contains personal info)
config/claude/history.jsonl
config/claude/settings.json
config/claude/ide/

# Node.js dependencies for local tooling
node_modules/
package-lock.json

# Python virtual environment and bytecode
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Python virtual environment
config/sketchybar/venv/

# Krisp local data (credentials and transcripts - never commit)
config/sketchybar/krisp-auth.json
config/sketchybar/krisp-auth.json.backup-*
config/sketchybar/krisp-transcripts/

# Claude Code savepoints and drafts
.claude/docs/savepoint_*.md
.claude/docs/draft_*.md

# Temporary files
tmp.txt
tmp*.txt
*.tmp
test-*.py
interactive-*.py
*-test-*.png
