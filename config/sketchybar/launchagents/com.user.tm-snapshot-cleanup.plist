<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.tm-snapshot-cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>HOME_DIR/.config/sketchybar/helpers/cleanup-tm-snapshots.sh</string>
    </array>

    <!-- Hourly, matching Time Machine's snapshot cadence. A WatchPaths trigger on
         /var/db/.TimeMachine.Results.plist never fires on macOS 26 (file is gone). -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>HOME_DIR/.config/sketchybar/logs/tm-cleanup-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>HOME_DIR/.config/sketchybar/logs/tm-cleanup-stderr.log</string>
</dict>
</plist>
