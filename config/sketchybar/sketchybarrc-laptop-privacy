#!/usr/bin/env zsh

# Laptop configuration - PRIVACY MODE (no meetings/todoist)
FONT_FACE="JetBrainsMono Nerd Font"

PLUGIN_DIR="$HOME/.config/sketchybar/plugins-laptop"
PLUGIN_SHARED_DIR="$HOME/.config/sketchybar/plugins"

# Source environment-specific colors
source "$HOME/.config/sketchybar/helpers/source-colors.sh"

# Configurable notch width (default: 230px)
NOTCH_WIDTH=${NOTCH_WIDTH:-230}

# Configurable padding (default: 23px for laptop mode)
PADDING=${PADDING:-23}

sketchybar --bar \
    height=32 \
    color=$BAR_COLOR \
    margin=0 \
    sticky=on \
    padding_left=$PADDING \
    padding_right=$PADDING \
    notch_width=$NOTCH_WIDTH \
    display=all

sketchybar --default \
    background.color=$BACKGROUND_LESS_TRANSPARENT \
    background.corner_radius=5 \
    background.padding_right=5 \
    background.height=26 \
    icon.font="$FONT_FACE:Medium:15.0" \
    icon.padding_left=5 \
    icon.padding_right=5 \
    label.font="$FONT_FACE:Medium:12.0" \
    label.color=$LABEL_COLOR \
    label.y_offset=0 \
    label.padding_left=0 \
    label.padding_right=5

# Aerospace workspace indicators
for sid in 1 2 3 4 5 6 7 8 9; do
    sketchybar --add item space.$sid left \
        --set space.$sid \
        label="$sid" \
        label.font="$FONT_FACE:Bold:14.0" \
        label.padding_left=8 \
        label.padding_right=8 \
        label.y_offset=0 \
        label.color=$LABEL_COLOR \
        icon.drawing=off \
        background.color=$BACKGROUND_LESS_TRANSPARENT \
        background.corner_radius=5 \
        background.height=26 \
        background.padding_left=2 \
        background.padding_right=2 \
        script="$PLUGIN_SHARED_DIR/aerospace.sh" \
        click_script="aerospace workspace $sid" \
        --subscribe space.$sid aerospace_workspace_change
done

# Separator
sketchybar --add item separator left \
    --set separator \
    background.color=$TRANSPARENT \
    icon="│" \
    icon.color=$BACKGROUND_LESS_TRANSPARENT \
    icon.font="$FONT_FACE:Regular:16.0" \
    label.drawing=off

sketchybar --add item front_app left \
    --set front_app \
    background.color=$TEAL \
    background.padding_left=0 \
    background.padding_right=0 \
    icon.padding_left=7 \
    icon.padding_right=7 \
    icon.y_offset=1 \
    icon.color=$WIDGET_ICON_COLOR \
    label.drawing=no \
    script="$PLUGIN_SHARED_DIR/front_app.sh" \
    --add item front_app.separator left \
    --set front_app.separator \
    background.color=$TRANSPARENT \
    background.padding_left=-3 \
    icon= \
    icon.color=$TEAL \
    icon.font="$FONT_FACE:Bold:20.0" \
    icon.padding_left=0 \
    icon.padding_right=0 \
    icon.y_offset=1 \
    label.drawing=no \
    --add item front_app.name left \
    --set front_app.name \
    background.color=$TRANSPARENT \
    background.padding_right=0 \
    icon.drawing=off \
    label.font="$FONT_FACE:Bold:12.0" \
    label.padding_left=5 \
    label.drawing=yes

sketchybar --add bracket front_app_bracket \
    front_app \
    front_app.separator \
    front_app.name \
    icon.padding_left=15 \
    --subscribe front_app front_app_switched

# PRIVACY MODE: NO Todoist or Meeting widgets

sketchybar --add item week_num right \
    --set week_num \
    background.color=$YELLOW \
    background.padding_left=0 \
    background.padding_right=0 \
    icon.drawing=off \
    label.font="$FONT_FACE:Bold:12.0" \
    label.color=$BLACK \
    label.padding_left=10 \
    label.padding_right=10 \
    label.y_offset=1 \
    label="W30" \
    update_freq=3600 \
    script="$PLUGIN_SHARED_DIR/week_simple.sh" \
    click_script="$PLUGIN_SHARED_DIR/calendar_popup.sh" \
    popup.align=right \
    popup.height=32 \
    popup.topmost=on \
    popup.blur_radius=60 \
    popup.background.color=0xE02C2C2E \
    popup.background.corner_radius=20 \
    popup.background.border_width=1 \
    popup.background.border_color=0x15FFFFFF \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color=0x80000000 \
    popup.background.shadow.distance=15 \
    popup.background.shadow.angle=90 \
    --add item week_num.separator right \
    --set week_num.separator \
    background.color=$TRANSPARENT \
    background.padding_left=-3 \
    icon= \
    icon.color=$YELLOW \
    icon.font="$FONT_FACE:Bold:20.0" \
    icon.padding_left=0 \
    icon.padding_right=0 \
    icon.y_offset=1 \
    label.drawing=no \
    click_script="$PLUGIN_SHARED_DIR/calendar_popup.sh" \
    --add item clock right \
    --set clock \
    background.color=$TRANSPARENT \
    icon.drawing=off \
    label.font="$FONT_FACE:Bold:12.0" \
    label.padding_left=10 \
    label.padding_right=5 \
    label.drawing=yes \
    update_freq=10 \
    script="$PLUGIN_SHARED_DIR/clock.sh" \
    click_script="$PLUGIN_SHARED_DIR/calendar_popup.sh"

sketchybar --add bracket datetime_bracket \
    clock \
    week_num.separator \
    week_num \
    icon.padding_left=15

# Calendar popup items
sketchybar --add item week_num.popup.header popup.week_num \
    --set week_num.popup.header \
    label.font="$FONT_FACE:Medium:12.0" \
    icon.drawing=off \
    background.color=$TRANSPARENT \
    background.padding_top=0 \
    background.padding_bottom=0 \
    label.padding_top=14 \
    label.padding_bottom=8 \
    label.padding_left=12 \
    label.padding_right=12 \
    drawing=off

for i in {1..9}; do
    sketchybar --add item week_num.popup.week_$i popup.week_num \
        --set week_num.popup.week_$i \
        label.font="$FONT_FACE:Regular:11.0" \
        icon.drawing=off \
        background.color=$TRANSPARENT \
        background.corner_radius=0 \
        background.padding_left=12 \
        background.padding_right=12 \
        background.padding_top=4 \
        background.padding_bottom=4 \
        drawing=off
done

# Right side widgets
sketchybar --add item battery right \
    --set battery \
    icon.color=$PEACH \
    label.drawing=true \
    update_freq=120 \
    script="$PLUGIN_SHARED_DIR/battery.sh" \
    --subscribe battery power_source_change system_woke

sketchybar --add item volume right \
    --set volume \
    icon.color=$WIDGET_ICON_COLOR \
    label.drawing=true \
    script="$PLUGIN_SHARED_DIR/volume.sh" \
    --subscribe volume volume_change

sketchybar --add item cpu right \
    --set cpu \
    icon="CPU" \
    icon.color=$GREEN \
    icon.font="$FONT_FACE:Bold:10.0" \
    icon.y_offset=0 \
    label.drawing=true \
    update_freq=2 \
    script="$PLUGIN_SHARED_DIR/cpu.sh" \
    click_script="$PLUGIN_SHARED_DIR/system_stats_popup.sh" \
    popup.align=right \
    popup.height=32 \
    popup.topmost=on \
    popup.blur_radius=60 \
    popup.background.color=0xE02C2C2E \
    popup.background.corner_radius=20 \
    popup.background.border_width=1 \
    popup.background.border_color=0x15FFFFFF \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color=0x80000000 \
    popup.background.shadow.distance=15 \
    popup.background.shadow.angle=90

sketchybar --add item memory right \
    --set memory \
    icon="RAM" \
    icon.color=$GREEN \
    icon.font="$FONT_FACE:Bold:10.0" \
    icon.y_offset=0 \
    label.drawing=true \
    update_freq=3 \
    script="$PLUGIN_SHARED_DIR/memory.sh" \
    click_script="$PLUGIN_SHARED_DIR/system_stats_popup.sh" \
    popup.align=right \
    popup.height=32 \
    popup.topmost=on \
    popup.blur_radius=60 \
    popup.background.color=0xE02C2C2E \
    popup.background.corner_radius=20 \
    popup.background.border_width=1 \
    popup.background.border_color=0x15FFFFFF \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color=0x80000000 \
    popup.background.shadow.distance=15 \
    popup.background.shadow.angle=90

sketchybar --add item disk right \
    --set disk \
    icon="HD" \
    icon.color=$GREEN \
    icon.font="$FONT_FACE:Bold:10.0" \
    icon.y_offset=0 \
    label.drawing=true \
    update_freq=30 \
    script="$PLUGIN_SHARED_DIR/disk.sh"

# System stats popup items - top 10 consumers
# CPU top 10 processes
for i in {1..10}; do
    sketchybar --add item stats.popup.cpu_$i popup.cpu \
        --set stats.popup.cpu_$i \
        icon.font="$FONT_FACE:Regular:12.0" \
        icon.padding_left=12 \
        icon.padding_right=6 \
        label.font="$FONT_FACE:Regular:11.0" \
        label.padding_right=12 \
        label.padding_top=4 \
        label.padding_bottom=4 \
        background.color=$TRANSPARENT \
        drawing=off
done

# Memory top 10 processes
for i in {1..10}; do
    sketchybar --add item stats.popup.mem_$i popup.memory \
        --set stats.popup.mem_$i \
        icon.font="$FONT_FACE:Regular:12.0" \
        icon.padding_left=12 \
        icon.padding_right=6 \
        label.font="$FONT_FACE:Regular:11.0" \
        label.padding_right=12 \
        label.padding_top=4 \
        label.padding_bottom=4 \
        background.color=$TRANSPARENT \
        drawing=off
done

##### Finalizing Setup #####
# Initialize aerospace workspace highlighting
$PLUGIN_SHARED_DIR/aerospace_update_all.sh

sketchybar --update