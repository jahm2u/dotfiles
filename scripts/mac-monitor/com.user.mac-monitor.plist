<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.mac-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>HOME_DIR/.local/share/mac-monitor/venv/bin/python3</string>
        <string>DOTFILES_DIR/scripts/mac-monitor/mac_monitor.py</string>
        <string>--config</string>
        <string>DOTFILES_DIR/scripts/mac-monitor/config.json</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>HOME_DIR/.local/share/mac-monitor/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>HOME_DIR/.local/share/mac-monitor/logs/stderr.log</string>
</dict>
</plist>
