# Sketchybar Environment Configuration Example
# ==============================================
# This file demonstrates the configuration variables used by Sketchybar and its helpers.
# Copy this file to .env and update with your actual values.
#
# IMPORTANT: The .env file is git-ignored for privacy. Never commit sensitive URLs or tokens.
# Recommended permissions: chmod 600 .env

# Environment Type
# ----------------
# Controls color scheme and padding configuration
# Options: personal, ipm
ENV_TYPE=personal

# Display Mode Padding
# --------------------
# Padding values (in pixels) for laptop vs external display modes
PADDING_LAPTOP=6
PADDING_EXTERNAL=12

# Calendar Synchronization Configuration
# =======================================
# Calendar URLs are configured using the CALENDAR_URL_* pattern.
# Each variable defines a separate calendar source that will be synced to khal.
#
# Naming Convention:
#   CALENDAR_URL_{SUFFIX}=https://example.com/calendar.ics
#
# The SUFFIX determines the calendar name (converted to lowercase).
# Examples:
#   CALENDAR_URL_GOOGLE → calendar name: "google"
#   CALENDAR_URL_WORK   → calendar name: "work"
#   CALENDAR_URL_PERSONAL → calendar name: "personal"
#
# URL Requirements:
#   - Must be valid .ics (iCalendar) URLs
#   - Must start with http:// or https://
#   - URLs may contain authentication tokens in query strings
#
# Supported Calendar Sources:
# ----------------------------

# Google Calendar
# Get your secret calendar URL from Google Calendar settings:
# Settings > Settings for my calendars > [Calendar Name] > Integrate calendar > Secret address in iCal format
CALENDAR_URL_GOOGLE=https://calendar.google.com/calendar/ical/your_calendar_id/basic.ics

# Microsoft Outlook/Office 365 Calendar
# Get your calendar URL from Outlook settings:
# Settings > Calendar > Shared calendars > Publish a calendar > ICS link
CALENDAR_URL_WORK=https://outlook.office365.com/owa/calendar/your_calendar_id/calendar.ics

# Apple iCloud Calendar
# Get your calendar URL from iCloud calendar settings:
# Share Calendar > Public Calendar > Copy webcal URL (change webcal:// to https://)
CALENDAR_URL_PERSONAL=https://p01-caldav.icloud.com/published/2/your_calendar_id

# Additional calendars (optional)
# Add as many calendar sources as needed using the CALENDAR_URL_* pattern
# CALENDAR_URL_FAMILY=https://example.com/family-calendar.ics
# CALENDAR_URL_TEAM=https://example.com/team-calendar.ics

# Calendar History Window
# -----------------------
# Number of days to retain past events (older events will be removed during sync)
# Default: 7 days
CALENDAR_HISTORY_DAYS=7


# TODOIST Integration
# -----------------------
TODOIST_API_TOKEN=XXX


# Legacy Configuration (Deprecated)
# ==================================
# The following format is deprecated but still supported for backward compatibility.
# Please migrate to the CALENDAR_URL_* pattern above.
#
# ICAL_URLS=https://calendar1.example.com/feed.ics,https://calendar2.example.com/feed.ics
#
# Migration Guide:
#   Old: ICAL_URLS=https://cal1.com/feed.ics,https://cal2.com/feed.ics
#   New: CALENDAR_URL_PRIMARY=https://cal1.com/feed.ics
#        CALENDAR_URL_SECONDARY=https://cal2.com/feed.ics

# Troubleshooting
# ===============
# - Ensure .env file is in project root directory (~/dotfiles/.env)
# - Verify URLs are accessible (test with curl)
# - Check logs at config/sketchybar/logs/calendar-sync.log
# - Run manually: bash config/sketchybar/helpers/sync-calendars.sh
# - List khal calendars: khal printcalendars
# - Check calendar directories: ls -la ~/.local/share/khal/calendars/
