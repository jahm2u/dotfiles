# Dotfiles Environment Configuration
# Copy this to .env and fill in your values
# Never commit .env to git (already in .gitignore)

# ==========================================
# JONAS API (Meeting Prep)
# ==========================================
# URL for Jonas API - handles meeting classification, history analysis, and note generation
# Default: https://jonas.ilovejeff.co
JONAS_API_URL="https://jonas.ilovejeff.co"

# ==========================================
# OBSIDIAN VAULT
# ==========================================
# Absolute path to your Obsidian vault root directory
OBSIDIAN_VAULT_PATH="/Users/yourusername/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault"

# ==========================================
# OPENAI API (Legacy)
# ==========================================
# No longer used by meeting-prep (now uses Jonas API)
# May still be required by other scripts
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

