# Dotfiles Environment Configuration
# Copy this file to .env (in the root of the dotfiles repo) and fill in your values
# Location: ~/dotfiles/.env (or wherever you cloned this repo)

# Environment type: IPM (Brazil colors) or PERSONAL (Catppuccin colors)
ENV_TYPE=IPM

# Padding values for different display modes
PADDING_LAPTOP=23
PADDING_EXTERNAL=23

# Todoist API Token
# Get your token from: https://todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=your_todoist_token_here

# Calendar iCal URLs (comma-separated)
# Example: ICAL_URLS=https://calendar.google.com/calendar/ical/.../basic.ics,https://user.fm/calendar/ical/.../basic.ics
ICAL_URLS=your_calendar_urls_here
