# Dotfiles Environment Configuration
# Copy this to .env and fill in your values
# Never commit .env to git (already in .gitignore)

# ==========================================
# OBSIDIAN VAULT
# ==========================================
# Absolute path to your Obsidian vault root directory
OBSIDIAN_VAULT_PATH="/Users/yourusername/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault"

# ==========================================
# OPENAI API
# ==========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# TELEGRAM NOTIFICATIONS
# ==========================================
# Required for Krisp download notifications
# Setup instructions:
#   1. Message @BotFather on Telegram and create a bot
#   2. Copy the bot token provided
#   3. Message @userinfobot on Telegram to get your chat ID
#   4. Add both values below
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="123456789"

# ==========================================
# KRISP AUTOMATION (Advanced)
# ==========================================
# These are optional - defaults work fine
# KRISP_DOWNLOAD_INTERVAL="3600"  # Seconds between downloads (default: 1 hour)
# KRISP_MAX_RETRIES="5"           # Max retries for failed downloads
